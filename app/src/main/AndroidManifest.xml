<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CibertecApp">

        <!-- Splash & Auth -->
        <activity
            android:name=".features.auth.presentation.activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".features.auth.presentation.activities.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".features.auth.presentation.activities.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".features.auth.presentation.activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".features.home.presentation.activities.HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />


        <activity
            android:name=".features.requests.presentation.activities.RequestsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />


        <activity
            android:name=".features.repairs.presentation.activities.RepairsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".features.repairs.presentation.activities.RepairDetailActivity"
            android:exported="false" />

        <activity
            android:name=".features.repairs.presentation.activities.NewRepairActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".features.repairs.presentation.activities.PaymentReceiptActivity"
            android:exported="false" />

        <activity
            android:name=".features.repairs.presentation.activities.PaymentActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Esta es la dirección que Mercado Pago usará para volver con éxito -->
                <data android:scheme="reparatech" android:host="success" />
                <data android:scheme="reparatech" android:host="failure" />
            </intent-filter>
        </activity>

        <!-- Devices -->
        <activity
            android:name=".features.devices.presentation.activities.DevicesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".features.devices.presentation.activities.AddDeviceActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".features.devices.presentation.activities.DeviceDetailActivity"
            android:exported="false" />

        <!-- Profile & Security -->
        <activity
            android:name=".features.profile.presentation.activities.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".features.profile.presentation.activities.PersonalInfoActivity"
            android:exported="false" />

        <activity
            android:name=".features.profile.presentation.activities.SecurityActivity"
            android:exported="false" />

        <!-- Support -->
        <activity
            android:name=".features.support.presentation.activities.SupportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />





        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

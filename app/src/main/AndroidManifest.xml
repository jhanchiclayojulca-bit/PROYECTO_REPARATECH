<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CibertecApp">
        <activity
            android:name=".features.auth.presentation.activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".features.auth.presentation.activities.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".HomeClientActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileClientActivity"
            android:exported="false" />
        <activity
            android:name=".DevicesClientActivity"
            android:exported="false" />
        <activity
            android:name=".AddDeviceActivity"
            android:exported="false" />
        <activity
            android:name=".DeviceDetailActivity"
            android:exported="false" />
        <activity
            android:name=".SupportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PersonalInfoActivity"
            android:exported="false" />
        <activity
            android:name=".RequestConfirmationActivity"
            android:exported="false" />
        <activity
            android:name=".RequestsClientActivity"
            android:exported="false" />
        <activity
            android:name=".RepairsClientActivity"
            android:exported="false" />
        <activity
            android:name=".PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".PaymentReceiptActivity"
            android:exported="false" />
    </application>

</manifest>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CibertecApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main Brand Colors -->
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Navigation / Secondary Colors -->
        <item name="colorSecondaryContainer">#44474E</item>
        <item name="colorOnSecondaryContainer">#D1E4FF</item>

        <!-- Surface Colors -->
        <item name="colorSurface">@color/surface_bright</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/surface_bright</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_bright</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Fix for Black Flickers -->
        <item name="android:windowBackground">@color/surface_bright</item>

        <!-- Global Axis-Z Transitions -->
        <item name="android:windowAnimationStyle">@style/CustomActivityAnimation</item>
    </style>
</resources>
